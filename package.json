{
    "name": "picredux",
    "productName": "PicRedux",
    "version": "1.0.0",
    "description": "L'outil ultime de compression d'images pour les pros par Nebulabs.",
    "type": "module",
    "main": "electron/main.cjs",
    "author": "Nebulabs <nebulabs.hq@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/NebulabsHQ/PicRedux-Releases.git"
    },
    "homepage": "https://nebulabs.gumroad.com",
    "scripts": {
        "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "install:sharp-universal": "node scripts/install-sharp-universal.cjs",
        "build": "npm run install:sharp-universal && rm -rf dist && vite build && electron-builder",
        "build:vite": "vite build",
        "preview": "vite preview",
        "electron": "electron .",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "npm run build:vite && electron .",
        "dist": "npm run build:vite && electron-builder",
        "postinstall": "electron-builder install-app-deps",
        "rebuild": "electron-builder install-app-deps",
        "publish": "npm run build:vite && electron-builder --publish always $(node -e \"console.log(process.arch === 'arm64' ? '--arm64' : '--x64')\")",
        "publish:arm": "npm run build:vite && electron-builder --arm64 --publish always",
        "publish:intel": "npm run build:vite && electron-builder --x64 --publish always",
        "publish:win": "npm run build:vite && electron-builder --win --publish always"
    },
    "build": {
        "appId": "com.picredux.app",
        "productName": "PicRedux",
        "copyright": "Copyright © 2025 PicRedux",
        "compression": "maximum",
        "asarUnpack": [
            "**/node_modules/sharp/**/*",
            "**/node_modules/@img/**/*",
            "**/node_modules/heic-convert/**/*",
            "**/node_modules/heic-decode/**/*"
        ],
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "dist/**/*",
            "!dist/mac-*",
            "!dist/mac-*/**/*",
            "!dist/win-*",
            "!dist/win-*/**/*",
            "!dist/*.dmg",
            "!dist/*.zip",
            "!dist/*.exe",
            "!dist/*.yml",
            "!dist/*.yaml",
            "!dist/*.blockmap",
            "electron/**/*",
            "package.json",
            "node_modules/@img/**/*",
            "!**/*.md",
            "!**/*.map",
            "!**/test/**",
            "!**/tests/**",
            "!**/*.d.ts",
            "!**/docs/**",
            "!**/.github/**",
            "!**/example/**",
            "!**/examples/**"
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "NebulabsHQ",
                "repo": "PicRedux-Releases"
            }
        ],
        "mac": {
            "target": {
                "target": "dmg",
                "arch": [
                    "universal"
                ]
            },
            "category": "public.app-category.photography",
            "icon": "build/icon.icns",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "x64ArchFiles": "{**/@img/sharp-darwin-x64/**,**/@img/sharp-libvips-darwin-x64/**}",
            "singleArchFiles": "**/LICENSE*"
        },
        "dmg": {
            "sign": false
        },
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "dependencies": {
        "@img/sharp-libvips-darwin-arm64": "^1.2.4",
        "@img/sharp-libvips-darwin-x64": "^1.2.4",
        "clsx": "^2.1.1",
        "electron-log": "^5.0.0",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.1.7",
        "heic-convert": "^2.1.0",
        "lucide-react": "^0.562.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sharp": "^0.33.5",
        "tailwind-merge": "^3.4.0"
    },
    "optionalDependencies": {
        "@img/sharp-darwin-arm64": "^0.33.5",
        "@img/sharp-darwin-x64": "^0.33.5"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "electron": "^39.2.7",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "vite": "^7.3.0",
        "wait-on": "^7.2.0"
    }
}
